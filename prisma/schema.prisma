// Schema đầy đủ cho vận hành thật — 12 bảng.
//
// Sáu bảng đầu (users, credit_wallet, credit_transactions, products,
// generations, payments) là lõi nghiệp vụ, giữ nguyên từ bản MVP.
//
// Sáu bảng sau được thêm khi chuẩn bị mở cho người dùng thật:
//   sessions          phiên THU HỒI ĐƯỢC — không có nó thì token bị đánh cắp
//                     vẫn sống đủ 30 ngày và không ai chặn được
//   saved_scripts     kịch bản người bán chọn giữ lại
//   generated_assets  mỗi ảnh sinh ra một dòng, để liệt kê và xoá được
//   api_usage         số đối soát giá vốn theo từng lần gọi provider
//   audit_logs        ai đổi gì — cần khi có khiếu nại credit
//   notifications     báo cho người bán khi việc chạy xong
//
// Ranh giới CHỨC NĂNG vẫn giữ: GenerationType chỉ có 3 giá trị. Thêm chức năng
// thứ tư vẫn phải sửa enum đó — ma sát cố ý, xem docs/scope.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Supabase: DATABASE_URL đi qua connection pooler (cổng 6543) — app chạy
  // serverless, mỗi request một lambda, không thể mỗi cái giữ một connection thật.
  url = env("DATABASE_URL")

  // Pooler ở chế độ transaction không chạy được DDL, nên `prisma db push` /
  // `migrate` phải đi đường trực tiếp (cổng 5432). Prisma tự chọn đúng URL.
  // Postgres local: điền cùng một chuỗi cho cả hai biến.
  directUrl = env("DIRECT_URL")
}

enum Industry {
  MY_PHAM // mỹ phẩm
  THOI_TRANG // thời trang
  GIA_DUNG // gia dụng
  ME_VA_BE // mẹ & bé
  PHU_KIEN // phụ kiện
}

enum GenerationType {
  PRODUCT_PHOTO // ảnh sản phẩm: tách nền + ghép bối cảnh
  LISTING_COPY // tiêu đề + mô tả + hashtag
  VIDEO_SCRIPT // 5 kịch bản video 30s
}

enum GenerationStatus {
  PENDING // đã tạo bản ghi, chưa trừ credit
  RUNNING // đã trừ credit, đang gọi provider
  SUCCEEDED
  FAILED // đã hoàn credit (nếu đã trừ)
}

enum CreditTxnType {
  TOPUP // nạp từ payment
  BONUS // tặng khi đăng ký
  DEBIT // trừ trước khi gọi API
  REFUND // hoàn khi provider lỗi
  ADJUSTMENT // CSKH chỉnh tay
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  phone     String?
  // Ngành hàng mặc định — bắt chọn ngay bước đầu, quyết định bộ prompt.
  industry  Industry?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  wallet       CreditWallet?
  transactions CreditTransaction[]
  products     Product[]
  generations  Generation[]
  payments     Payment[]

  sessions      Session[]
  savedScripts  SavedScript[]
  assets        GeneratedAsset[]
  apiUsage      ApiUsage[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("users")
}

model CreditWallet {
  id      String @id @default(cuid())
  userId  String @unique
  balance Int    @default(0)

  // Cộng dồn để đối soát: balance phải luôn == totalIn - totalOut.
  totalIn  Int @default(0)
  totalOut Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credit_wallet")
}

model CreditTransaction {
  id           String        @id @default(cuid())
  userId       String
  walletId     String
  type         CreditTxnType
  // Âm khi trừ, dương khi cộng. Sổ cái append-only, không bao giờ UPDATE.
  delta        Int
  balanceAfter Int

  // Chống trừ/hoàn hai lần. Ví dụ: "debit:<generationId>", "refund:<generationId>".
  idempotencyKey String   @unique
  generationId   String?
  paymentId      String?
  note           String?
  createdAt      DateTime @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet     CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  generation Generation?  @relation(fields: [generationId], references: [id], onDelete: SetNull)
  payment    Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model Product {
  id       String   @id @default(cuid())
  userId   String
  industry Industry
  name     String

  // Ảnh gốc chụp bằng điện thoại + ảnh đã tách nền (cache, tách 1 lần dùng lại).
  originalImageKey String
  cutoutImageKey   String?

  // Vài dòng thông tin người bán nhập: giá, chất liệu, size, đối tượng, USP...
  // Json vì mỗi ngành hỏi một bộ field khác nhau.
  info Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations  Generation[]
  savedScripts SavedScript[]
  assets       GeneratedAsset[]

  @@index([userId, createdAt])
  @@map("products")
}

model Generation {
  id        String           @id @default(cuid())
  userId    String
  productId String?
  type      GenerationType
  status    GenerationStatus @default(PENDING)
  industry  Industry

  input  Json  @default("{}")
  output Json?

  // Credit đã trừ. Về 0 sau khi hoàn.
  creditsCharged Int     @default(0)
  provider       String?
  providerJobId  String?

  // Giá thực tế provider tính cho lần chạy này (VND).
  // Đây là nguồn dữ liệu để chốt tỷ lệ credit — KHÔNG đoán, đọc từ đây.
  providerCostVnd Int?

  errorCode    String?
  errorMessage String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  transactions CreditTransaction[]
  savedScripts SavedScript[]
  assets       GeneratedAsset[]
  apiUsage     ApiUsage[]

  @@index([userId, createdAt])
  @@index([type, status])
  @@map("generations")
}

model Payment {
  id     String @id @default(cuid())
  userId String

  packId    String
  amountVnd Int
  credits   Int

  provider    String // "bank_transfer" | "momo" | ...
  providerRef String? // mã giao dịch / nội dung chuyển khoản
  status      PaymentStatus @default(PENDING)
  raw         Json? // payload webhook gốc, để đối soát

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@map("payments")
}

// ===========================================================================
// Vận hành
// ===========================================================================

enum AssetKind {
  ORIGINAL // ảnh người bán tải lên
  CUTOUT // ảnh đã tách nền, cache dùng lại
  SCENE // ảnh đã ghép bối cảnh
}

/**
 * Phiên đăng nhập — thu hồi được.
 * JWT một mình không thu hồi được: đánh cắp là dùng tới lúc hết hạn, không ai
 * chặn nổi. Bảng này biến "đăng xuất" thành thao tác có thật, và cho người bán
 * thấy thiết bị nào đang đăng nhập.
 * Lưu HASH của token, KHÔNG lưu token thô: rò rỉ database thì kẻ lấy được cũng
 * không dựng lại được phiên nào.
 */
model Session {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique

  userAgent String?
  ip        String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("sessions")
}

/**
 * Kịch bản người bán bấm giữ lại. Sinh ra 5 cái, thường chỉ quay 1-2.
 */
model SavedScript {
  id           String  @id @default(cuid())
  userId       String
  productId    String
  generationId String?

  angle        String
  /// Nguyên hình dạng ScriptSchema — đọc lại được bằng trình phát 9:16.
  script       Json
  totalSeconds Int

  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([productId])
  @@map("saved_scripts")
}

/**
 * Mỗi ảnh một dòng.
 * Trước đây ảnh chỉ nằm trong `generations.output` dạng JSON nên không liệt kê
 * hay xoá lẻ được — mà xoá được là bắt buộc: người bán có quyền yêu cầu xoá
 * ảnh sản phẩm của họ.
 */
model GeneratedAsset {
  id           String  @id @default(cuid())
  userId       String
  productId    String?
  generationId String?

  kind       AssetKind
  sceneId    String?
  storageKey String    @unique
  mimeType   String
  bytes      Int
  width      Int?
  height     Int?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([productId, kind])
  @@map("generated_assets")
}

/**
 * Một dòng cho mỗi lần gọi provider.
 * Đây là số để chốt tỷ lệ credit — `docs/unit-economics.md` nói đi nói lại là
 * đừng đoán giá vốn. Có bảng này thì đối soát được theo provider, theo model,
 * và thấy được lần gọi hỏng tốn bao nhiêu.
 */
model ApiUsage {
  id           String  @id @default(cuid())
  userId       String?
  generationId String?

  provider String // "gemini" | "kling" | "claude" | "deepseek"
  model    String

  inputTokens  Int?
  outputTokens Int?
  images       Int?

  costVnd    Int?
  /// INVOICE | METERED | LIST_PRICE — nguồn con số, quan trọng ngang con số.
  costSource String?

  latencyMs Int?
  ok        Boolean @default(true)
  errorCode String?

  createdAt DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([generationId])
  @@map("api_usage")
}

/**
 * Ai đổi gì. Cần khi người bán khiếu nại credit và phải dựng lại chuyện đã xảy ra.
 */
model AuditLog {
  id     String  @id @default(cuid())
  /// null = hệ thống tự làm (webhook, cron).
  userId String?

  action   String // "user.industry_changed", "credit.adjusted", "session.revoked"
  entity   String? // "user" | "payment" | "generation"
  entityId String?

  before Json?
  after  Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/**
 * Báo cho người bán khi việc chạy xong hoặc credit sắp hết.
 */
model Notification {
  id     String @id @default(cuid())
  userId String

  kind  String // "generation_done" | "payment_received" | "low_credit"
  title String
  body  String?
  link  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
