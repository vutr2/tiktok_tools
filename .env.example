
# --- Cổng thanh toán SePay ---
# sandbox = môi trường thử, production = tiền thật.
# Bỏ trống MERCHANT_ID/SECRET_KEY thì trang thanh toán báo chưa cấu hình.
SEPAY_ENV="sandbox"
SEPAY_MERCHANT_ID=""
SEPAY_SECRET_KEY=""
# Địa chỉ gốc để SePay biết đường quay về. Trên Vercel có thể bỏ trống
# (tự lấy từ VERCEL_URL), nhưng đặt tay thì chắc hơn.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Lưu ảnh (Supabase Storage) ---
# Bucket phải để RIÊNG TƯ. Ảnh phục vụ bằng signed URL hết hạn sau 1 giờ.
SUPABASE_STORAGE_BUCKET="product-images"
