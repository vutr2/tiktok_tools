# --- Bắt buộc ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tiktok_tools?schema=public"
AUTH_SECRET="doi-chuoi-nay-truoc-khi-len-production-toi-thieu-32-ky-tu"

# --- Sinh text (tiêu đề/mô tả/hashtag/kịch bản) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Sinh ảnh ---
# mock  = chạy được không cần credential, dùng để dev và demo
# higgsfield = provider thật
IMAGE_PROVIDER="mock"
HIGGSFIELD_API_KEY=""
HIGGSFIELD_API_BASE="https://platform.higgsfield.ai/v1"
# Đường dẫn endpoint để trong env vì phải đối chiếu tài liệu Higgsfield trước khi
# bật production — xem docs/unit-economics.md, mục "Trước khi bật provider thật".
HIGGSFIELD_GENERATE_PATH="/image/generate"
HIGGSFIELD_JOB_PATH="/jobs"
HIGGSFIELD_REMOVE_BG_PATH="/image/remove-background"

# --- Lưu file ---
STORAGE_DIR="./storage"

# --- Kinh tế đơn vị (xem src/lib/pricing.ts) ---
# Giá THỰC TẾ mỗi ảnh của provider, tính bằng VND. Để trống = chưa đo.
# Script `npm run economics` sẽ từ chối chốt tỷ lệ credit khi biến này trống.
IMAGE_COST_VND_PER_SCENE=""
BG_REMOVAL_COST_VND=""
USD_VND="26300"

# Tặng credit khi đăng ký — text là mồi kéo người dùng.
SIGNUP_BONUS_CREDITS="10"
