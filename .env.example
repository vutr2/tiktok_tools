# --- Database (Supabase Postgres) ---
# Lấy hai chuỗi này ở Supabase Dashboard > nút "Connect" > tab ORMs > Prisma.
# Dán nguyên văn, đừng gõ tay hostname — Supabase đổi định dạng theo thời gian.
#
# DATABASE_URL = Transaction pooler (cổng 6543). App chạy serverless, mỗi request
#   một lambda; không đi qua pooler thì Postgres hết connection trước khi hết tiền.
#   Bắt buộc có `?pgbouncer=true` (tắt prepared statement, pooler không giữ được).
#   `connection_limit=1` vì mỗi lambda chỉ cần đúng một connection.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = Session pooler / direct (cổng 5432). Chỉ dùng cho `npm run db:push`
#   và `prisma migrate` — pooler transaction mode không chạy được DDL.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Postgres local (không dùng Supabase): điền cùng một chuỗi cho cả hai biến.
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tiktok_tools?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tiktok_tools?schema=public"

# --- Bắt buộc ---
AUTH_SECRET="doi-chuoi-nay-truoc-khi-len-production-toi-thieu-32-ky-tu"

# --- Đăng nhập / đăng ký (Descope) ---
# Bỏ trống  = dùng form email sẵn có (không cần tài khoản Descope nào).
# Có điền   = màn đăng nhập chuyển sang flow Descope, email được XÁC MINH thật
#             trước khi tạo tài khoản và tặng credit.
# Project ID lấy ở Descope Console > Project Settings. Không phải bí mật —
# nó chạy ở trình duyệt nên bắt buộc mang tiền tố NEXT_PUBLIC_.
NEXT_PUBLIC_DESCOPE_PROJECT_ID=""
# Tên flow trong Descope Console. Mặc định "sign-up-or-in" là flow dựng sẵn.
NEXT_PUBLIC_DESCOPE_FLOW_ID="sign-up-or-in"

# --- Sinh text (tiêu đề/mô tả/hashtag/kịch bản) ---
# claude   = Claude Opus 5. Đắt nhất, có structured output ràng buộc schema.
# deepseek = DeepSeek V4. Rẻ hơn ~66 lần trên cùng workload, xem docs/unit-economics.md.
TEXT_PROVIDER="claude"

ANTHROPIC_API_KEY="sk-ant-..."

# --- DeepSeek (chỉ cần khi TEXT_PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# deepseek-v4-flash là model TEXT THUẦN — không đọc được ảnh.
DEEPSEEK_TEXT_MODEL="deepseek-v4-flash"
# App gửi ảnh sản phẩm cho model text, nên khi có ảnh phải dùng biến thể vision.
# Đây là model diện thử nghiệm, và DeepSeek chưa công bố giá rõ ràng cho nó →
# providerCostVnd sẽ là null. Đặt bằng DEEPSEEK_TEXT_MODEL nếu muốn bỏ ảnh đi.
DEEPSEEK_VISION_MODEL="deepseek-v4-flash-vision-exp"

# --- Sinh ảnh ---
# mock   = chạy được không cần credential, dùng để dev và demo
# gemini = Gemini image ("nano banana") — model SỬA ảnh, giữ nguyên chủ thể tốt
# kling  = Kling (Kuaishou) — model KHUẾCH TÁN, nó vẽ lại chủ thể.
#          Đối chứng với gemini trên đúng hàng của bạn trước khi đổi mặc định:
#          nhãn mác và chữ trên bao bì sai một chữ là ảnh vứt đi.
IMAGE_PROVIDER="mock"
GEMINI_API_KEY=""
# Xem bảng model + giá trong src/lib/pricing.ts (IMAGE_MODELS).
# Đừng dùng họ gemini-2.5-* : có lịch tắt 16/10/2026.
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"

# --- Kling (tuỳ chọn, chỉ cần khi IMAGE_PROVIDER=kling) ---
# Key dùng thẳng làm Bearer token, KHÔNG phải cặp AccessKey/SecretKey ký JWT.
KLING_API_KEY=""
KLING_BASE_URL="https://api.klingai.com"
# Model dùng được (đã dò trực tiếp trên API):
#   kling-v1, kling-v1-5, kling-v2, kling-v2-1, kling-v3
KLING_IMAGE_MODEL="kling-v2-1"
# Kling KHÔNG trả token đã dùng, nên không suy ra được giá vốn mỗi ảnh. Muốn có
# số trong `npm run economics` thì phải điền IMAGE_COST_VND_PER_SCENE từ hoá đơn.

# --- Lưu file ---
STORAGE_DIR="./storage"

# --- Thông tin nhận chuyển khoản (hiện trên màn Ví) ---
BANK_NAME="Vietcombank"
BANK_ACCOUNT=""
BANK_HOLDER=""

# --- Kinh tế đơn vị (xem src/lib/pricing.ts) ---
# Giá vốn mỗi ảnh, theo thứ tự tin cậy giảm dần:
#   1. IMAGE_COST_VND_PER_SCENE — số ĐỐI SOÁT TỪ HOÁ ĐƠN provider. Điền sau khi
#      chạy vài trăm ảnh đầu; đây là số duy nhất tính cả lần gọi hỏng và thuế.
#   2. GEMINI_IMAGE_USD_PER_MTOK — đơn giá token ảnh, để tính theo token API trả về.
#   3. Không điền gì -> dùng giá niêm yết của model, và `npm run economics` báo 🟡.
IMAGE_COST_VND_PER_SCENE=""
GEMINI_IMAGE_USD_PER_MTOK=""
USD_VND="26300"

# Tặng credit khi đăng ký — text là mồi kéo người dùng.
SIGNUP_BONUS_CREDITS="10"
